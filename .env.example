# Project
COMPOSE_PROJECT_NAME=fincore

# MinIO
MINIO_ROOT_USER=fincore_admin
MINIO_ROOT_PASSWORD=replace_with_a_strong_password
MINIO_ENDPOINT=http://minio:9000
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1

# Warehouse PostgreSQL
WAREHOUSE_DB=fincore_warehouse
WAREHOUSE_USER=fincore_user
WAREHOUSE_PASSWORD=replace_with_a_strong_password
WAREHOUSE_HOST=warehouse-db
WAREHOUSE_PORT=5432

# Airflow metadata PostgreSQL
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=replace_with_a_strong_password
AIRFLOW_DB_HOST=airflow-db
AIRFLOW_DB_PORT=5432

# Airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace_with_a_strong_password
AIRFLOW_ADMIN_EMAIL=admin@fincore.local
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=replace_with_a_long_random_secret

# Monitoring (Grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_password


# Spark
SPARK_MASTER_URL=spark://spark-master:7077

# Local notifications
SLACK_WEBHOOK_URL=
PAGERDUTY_WEBHOOK_URL=